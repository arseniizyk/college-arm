# Общий .env для docker compose
# Скопируйте: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=college_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=1111

# --- Порты, публикуемые на хосте ---
SERVER_PORT=7000
CLIENT_PORT=8080

# --- Node ---
NODE_ENV=production

# Таймзона для node-cron (планировщик бэкапов)
TZ=Europe/Minsk
